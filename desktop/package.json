{
  "name": "aquasculptor-studio-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "AquaSculptor desktop shell",
  "main": "main.js",
  "scripts": {
    "start": "cmd /c \"set ELECTRON_RUN_AS_NODE=&& electron .\"",
    "dist": "cmd /c \"set ELECTRON_RUN_AS_NODE=&& electron-builder\""
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "studio.aquasculptor",
    "productName": "AquaSculptor",
    "directories": { "output": "dist-installer" },
    "win": { "target": "nsis" }
  }
}
